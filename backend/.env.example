# Restaurant SaaS Backend Configuration

# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Restaurant_Saas
DB_PASSWORD=your_password_here
DB_PORT=5432

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_very_secret_key_change_this_in_production
JWT_EXPIRE=1h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email (optional - for future notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Payment Gateway (optional - for future payment processing)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
